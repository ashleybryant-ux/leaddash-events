{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["shared/*"], "@/*": ["client/src/*"] }
  },
  "include": ["server", "client/src", "shared", "drizzle", "tests", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts"]
}
